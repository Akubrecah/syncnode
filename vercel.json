{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://syncnode-web-production.up.railway.app/api/:path*" },
    { "source": "/ws", "destination": "https://syncnode-web-production.up.railway.app/ws" },
    { "source": "/admin/:path*", "destination": "https://syncnode-web-production.up.railway.app/admin/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

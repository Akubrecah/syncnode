{
  "name": "syncnode-root",
  "version": "1.0.0",
  "private": true,
  "description": "Syncnode Enterprise Cryptocurrency Exchange Infrastructure",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": ".venv/bin/uvicorn syncnode.server:app --host 0.0.0.0 --port 4000 --reload",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm --prefix apps/web run build",
    "test": ".venv/bin/pytest tests/ -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}

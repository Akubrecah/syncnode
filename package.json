{
  "name": "syncnode-root",
  "version": "1.0.0",
  "private": true,
  "description": "Syncnode Enterprise Cryptocurrency Exchange Infrastructure",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/**/*.test.js",
    "test:ts": "tsx --test tests/**/*.test.ts",
    "start": "tsx services/api-gateway/src/server.ts",
    "dev:server": "tsx watch services/api-gateway/src/server.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "button": "^1.1.1",
    "init": "^0.1.2",
    "shadcn": "^4.19.0"
  }
}

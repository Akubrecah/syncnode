# ==============================================================================
# SYNCNODE ENTERPRISE PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port & Binding
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (CRIT-001, CRIT-002, HIGH-005)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long. In production, generate using:
# openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_at_least_32_chars_secret_string!

# Access token lifespan (e.g., '15m', '1h')
JWT_EXPIRES_IN=15m

# Comma-separated list of permitted CORS origins (Never use '*' in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://signalist.syncnode.io

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE (Supabase Cloud PostgreSQL & MongoDB)
# ------------------------------------------------------------------------------
# Supabase Cloud Project Configuration (Recommended)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# MongoDB Connection URL (Optional Fallback)
MONGODB_URI=mongodb://localhost:27017/syncnode

# Optional Redis Cache / PubSub URL
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. RATE LIMITING (HIGH-008)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20

# ------------------------------------------------------------------------------
# 4. EXTERNAL MARKET DATA FEEDS
# ------------------------------------------------------------------------------
BINANCE_API_BASE_URL=https://api.binance.com
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ------------------------------------------------------------------------------
# 5. ADMIN CONSOLE BOOTSTRAP
# ------------------------------------------------------------------------------
# Required in production to create the initial SUPER_ADMIN account.
# In non-production environments, documented local development credentials are
# used automatically when these are not set.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
